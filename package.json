{
  "name": "watchsync",
  "version": "0.3.0",
  "description": "无服务器 P2P 网页视频同步观影",
  "type": "module",
  "author": "WatchSync",
  "license": "MIT",
  "scripts": {
    "dev": "npm run tauri:frontend:dev",
    "build": "npm run tauri:frontend:build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "tauri:gen-adapters": "node scripts/tauri/gen-adapters.mjs",
    "tauri:frontend:dev": "npm run tauri:gen-adapters && vite --config vite.renderer.config.ts",
    "tauri:frontend:build": "npm run tauri:gen-adapters && vite build --config vite.renderer.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:a": "tauri dev -- --profile=A --cdp-port=9223",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  },
  "dependencies": {
    "@trystero-p2p/nostr": "^0.25.4",
    "vue": "^3.5.0"
  }
}

