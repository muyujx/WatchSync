{
  "name": "watchsync",
  "version": "0.6.0",
  "description": "无服务器 P2P 网页视频同步观影",
  "type": "module",
  "author": "WatchSync",
  "license": "MIT",
  "scripts": {
    "gen:adapters": "node scripts/tauri/gen-adapters.mjs",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:two": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 -Two",
    "build:frontend": "npm run gen:adapters && vite build --config vite.renderer.config.ts",
    "build:rust": "cargo build --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri",
    "tauri:build": "tauri build && node scripts/copy-release.mjs",
    "debug:a": "powershell -NoProfile -Command \"Start-Process src-tauri\\target\\debug\\watchsync.exe -ArgumentList '--profile=A','--cdp-port=9222' -WindowStyle Hidden\"",
    "debug:b": "powershell -NoProfile -Command \"Start-Process src-tauri\\target\\debug\\watchsync.exe -ArgumentList '--profile=B','--cdp-port=9223' -WindowStyle Hidden\""
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  },
  "dependencies": {
    "@trystero-p2p/nostr": "^0.25.4",
    "vue": "^3.5.0"
  }
}

