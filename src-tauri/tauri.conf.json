{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WatchSync",
  "version": "0.5.0",
  "identifier": "com.watchsync.app",
  "build": {
    "beforeDevCommand": "npm run tauri:frontend:dev",
    "devUrl": "http://localhost:4555",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": false, "scope": [] }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
