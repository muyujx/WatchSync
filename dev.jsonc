{
  // 开发期限速：仅 npm run dev 生效；正式构建不读取，相关代码会被摇树移除。
  // 单位：KB/s（千字节/秒）。0 或省略 = 不限速。改完重载实例页面即可（或 __p2pDev.reload()）。
  // 临时覆盖（不写回文件）：控制台 window.__p2pDev.override({ p2pKBs: 500 })；查看：__p2pDev.status()

  // 实例间通信网速：房主经 DataChannel 推流发送 / 成员接收落盘。
  // 用于模拟两台实例之间的链路带宽（如 500 = 500KB/s）。
  "p2pKBs": 0,

  // 访问网络网速：房主回源，从 CDN 按 Range 拉取媒体字节的速率。
  // 用于模拟房主到源站的带宽（本地视频推流无回源，此项不生效）。
  "sourceKBs": 0
}